# name: test/sql/window_funnel_events.test
# group: [behavioral]

require behavioral

statement ok
CREATE TABLE funnel_ts_events (user_id INTEGER, ts TIMESTAMP, event VARCHAR);

statement ok
INSERT INTO funnel_ts_events VALUES
    (1, '2024-01-01 00:00:00', 'view'),
    (1, '2024-01-01 00:05:00', 'cart'),
    (1, '2024-01-01 00:10:00', 'purchase'),
    (2, '2024-01-01 00:00:00', 'view'),
    (2, '2024-01-01 05:00:00', 'cart'),
    (3, '2024-01-01 00:00:00', 'cart');

# Complete chain: one timestamp per matched step
query I
SELECT CAST(window_funnel_events(
    INTERVAL '1 hour', ts,
    event = 'view', event = 'cart', event = 'purchase') AS VARCHAR)
FROM funnel_ts_events WHERE user_id = 1;
----
['2024-01-01 00:00:00', '2024-01-01 00:05:00', '2024-01-01 00:10:00']

# Out-of-window second step: only the entry is matched
query I
SELECT CAST(window_funnel_events(
    INTERVAL '1 hour', ts,
    event = 'view', event = 'cart', event = 'purchase') AS VARCHAR)
FROM funnel_ts_events WHERE user_id = 2;
----
['2024-01-01 00:00:00']

# No entry condition matched: empty list
query I
SELECT CAST(window_funnel_events(
    INTERVAL '1 hour', ts,
    event = 'view', event = 'cart', event = 'purchase') AS VARCHAR)
FROM funnel_ts_events WHERE user_id = 3;
----
[]

# Per-user chains via GROUP BY
query II
SELECT user_id, len(window_funnel_events(
    INTERVAL '1 hour', ts,
    event = 'view', event = 'cart', event = 'purchase'))
FROM funnel_ts_events
GROUP BY user_id
ORDER BY user_id;
----
1	3
2	1
3	0

# Mode overload: strict_order
query I
SELECT CAST(window_funnel_events(
    INTERVAL '1 hour', 'strict_order', ts,
    event = 'view', event = 'cart', event = 'purchase') AS VARCHAR)
FROM funnel_ts_events WHERE user_id = 1;
----
['2024-01-01 00:00:00', '2024-01-01 00:05:00', '2024-01-01 00:10:00']

# Chain length always equals window_funnel's step count
query II
SELECT window_funnel(INTERVAL '1 hour', ts,
        event = 'view', event = 'cart', event = 'purchase') AS steps,
       len(window_funnel_events(INTERVAL '1 hour', ts,
        event = 'view', event = 'cart', event = 'purchase')) AS chain_len
FROM funnel_ts_events WHERE user_id = 2;
----
1	1

# Unknown mode strings raise an error (shared validation with window_funnel)
statement error
SELECT window_funnel_events(INTERVAL '1 hour', 'strict_typo', ts, event = 'view', event = 'cart')
FROM funnel_ts_events;
----
unknown mode 'strict_typo'
